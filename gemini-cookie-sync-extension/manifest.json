{
  "manifest_version": 3,
  "name": "Ngotra Gemini Connector",
  "version": "2.1",
  "description": "Securely connects your signed-in Gemini account to Ngotra.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "cookies",
    "downloads",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://google.com/*",
    "https://*.google.com/*",
    "http://localhost:8081/*",
    "https://ngotra.site/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ngotra Gemini Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8081/*",
        "https://ngotra.site/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
